# Copy to .env and start with: node --env-file=.env server/index.js
# Never commit the real .env.

# Leave DATABASE_URL empty to use PGlite (embedded Postgres) in data/pglite
DATABASE_URL=
PGLITE_DIR=data/pglite
# Required in production; a fixed local-only value is used when empty
JWT_SECRET_KEY=
PORT=3000
# Postgres pool size per server instance (defaults to 3)
PG_POOL_MAX=

# Only for scripts/fetch-usda.js (defaults to DEMO_KEY and 28 requests)
FDC_API_KEY=
FDC_BUDGET=
